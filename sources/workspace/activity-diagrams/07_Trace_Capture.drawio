        <mxCell id="56" value="&lt;b&gt;Note 3&lt;/b&gt;&lt;br&gt;Ledger retention: configured 5-7 years." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fillColor=#FFF9E8;strokeColor=#D5BD72;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="2868" width="1850" height="57" as="geometry" />
        </mxCell>
        <mxCell id="57" value="&lt;b&gt;Note 4&lt;/b&gt;&lt;br&gt;This activity runs independently of the consumer response; its join only joins capture tasks.&lt;br&gt;Persistence failure must not silently change the business decision outcome.&lt;br&gt;Retry, timeouts, reliable delivery and backpressure details require ADR.&lt;br&gt;Never store plaintext sensitive fields in execution traces." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fillColor=#FFF9E8;strokeColor=#D5BD72;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="2940" width="1850" height="123" as="geometry" />
        </mxCell>
      </root>
