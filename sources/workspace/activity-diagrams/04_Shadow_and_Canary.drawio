        <mxCell id="76" value="Swimlanes identify responsibility. Diamonds: decision / merge. Bars: parallel fork / join." style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="85" width="2231" height="40" as="geometry" />
        </mxCell>
        <mxCell id="77" value="&lt;b&gt;Note 1&lt;/b&gt;&lt;br&gt;F-14 Resolution: Rollout configuration, production evaluation, and diff querying are decoupled.&lt;br&gt;Shadow processing is dispatched asynchronously without blocking or mutating the production response.&lt;br&gt;Canary uses deterministic sticky hash or approved cohort routing." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fillColor=#FFF9E8;strokeColor=#D5BD72;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="3680" width="2231" height="101" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
