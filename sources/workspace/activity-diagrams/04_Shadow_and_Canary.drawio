        <mxCell id="75" value="RuleSphere - Activity Diagram — 04. Shadow and Canary Rollout | UC-15..17 — Production Evaluation and Shadow" style="text;html=1;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#243746;align=center;" vertex="1" parent="1">
