        <mxCell id="100" value="RuleSphere - Activity Diagram — 03. Governance and Artifact Build | UC-10..14" style="text;html=1;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#243746;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="3504" height="65" as="geometry" />
        </mxCell>
        <mxCell id="101" value="Swimlanes identify responsibility. Diamonds: decision / merge. Bars: parallel fork / join." style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="85" width="3504" height="40" as="geometry" />
        </mxCell>
        <mxCell id="102" value="&lt;b&gt;Note 1&lt;/b&gt;&lt;br&gt;Tier 1: one Domain Approver.&lt;br&gt;Tier 2: Domain Peer THEN Workspace Owner.&lt;br&gt;Tier 3: Domain Owner AND Compliance Officer.&lt;br&gt;Maker is excluded from every approval role." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fillColor=#FFF9E8;strokeColor=#D5BD72;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="4555" width="3504" height="123" as="geometry" />
        </mxCell>
        <mxCell id="103" value="&lt;b&gt;Note 2&lt;/b&gt;&lt;br&gt;Reuse of prior approvals needs explicit policy.&lt;br&gt;An edited revision cannot inherit approval implicitly." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fillColor=#FFF9E8;strokeColor=#D5BD72;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="4693" width="3504" height="79" as="geometry" />
        </mxCell>
        <mxCell id="104" value="&lt;b&gt;Note 3&lt;/b&gt;&lt;br&gt;Human review commands are separate requests over time, not an open HTTP call.&lt;br&gt;Approved does not mean Active. This activity describes governance, not a BPM engine." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fillColor=#FFF9E8;strokeColor=#D5BD72;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="4787" width="3504" height="79" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>