        <mxCell id="51" value="Swimlanes identify responsibility. Diamonds: decision / merge. Bars: parallel fork / join." style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="85" width="2215" height="40" as="geometry" />
        </mxCell>
        <mxCell id="52" value="&lt;b&gt;Note 1&lt;/b&gt;&lt;br&gt;Rollback reuses an eligible prior immutable artifact.&lt;br&gt;No cloning or rebuild needed." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fillColor=#FFF9E8;strokeColor=#D5BD72;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="1930" width="2215" height="79" as="geometry" />
        </mxCell>
        <mxCell id="53" value="&lt;b&gt;Note 2&lt;/b&gt;&lt;br&gt;Concurrent execution across all active fleet nodes.&lt;br&gt;Zero-restart in-memory load without interrupting in-flight requests." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fillColor=#FFF9E8;strokeColor=#D5BD72;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="2024" width="2215" height="79" as="geometry" />
        </mxCell>
        <mxCell id="54" value="&lt;b&gt;Note 3&lt;/b&gt;&lt;br&gt;F-14 Resolution: Decoupled into Promotion/Rollback, Fleet Synchronization, and Operator Query.&lt;br&gt;Fleet nodes synchronize concurrently with zero restart. Failed nodes retain valid loaded artifacts (FR-DIST-004).&lt;br&gt;SLA is &amp;lt;=2.0s from event emission to 100% active nodes loaded and eligible (NFR-CONS-001)." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fillColor=#FFF9E8;strokeColor=#D5BD72;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="2118" width="2215" height="101" as="geometry" />
        </mxCell>
      </root>
