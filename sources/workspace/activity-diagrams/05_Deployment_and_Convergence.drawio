        <mxCell id="26" value="RuleSphere - Activity Diagram — 05. Promote, Rollback and Convergence | UC-18..20, UC-27 — Fleet Status Query" style="text;html=1;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#243746;align=center;" vertex="1" parent="1">
